---
import { nav, site, whatsappLink } from '../data/site';

const path = '/' + Astro.url.pathname.slice(import.meta.env.BASE_URL.length).replace(/^\//, '');
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<div id="site-menu" data-open="false" aria-hidden="true" inert class="group/menu fixed inset-0 z-50 data-[open=false]:pointer-events-none">
  <svg class="absolute size-0" aria-hidden="true">
    <filter id="ripple" x="-5%" y="-30%" width="110%" height="160%">
      <feTurbulence id="ripple-turb" type="fractalNoise" baseFrequency="0.012 0.06" numOctaves="2" seed="2" result="n"></feTurbulence>
      <feDisplacementMap id="ripple-disp" in="SourceGraphic" in2="n" scale="0" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
    </filter>
  </svg>

  <!-- Click-away -->
  <button type="button" tabindex="-1" aria-hidden="true" data-menu-close class="absolute inset-0 cursor-default bg-ink/0 transition-colors duration-700 group-data-[open=true]/menu:bg-ink/30"></button>

  <div class="slab bg-ink" style="--k:0"></div>
  <div class="slab bg-linen" style="--k:1"></div>
  <nav class="slab on-paper flex flex-col justify-between overflow-y-auto bg-paper px-8 pt-24 pb-28 text-ink md:px-10 md:pb-10" style="--k:2" aria-label="Main menu">
    <ul>
      {
        nav.map((item, i) => (
          <li class="menu-item" style={`--i:${i}`}>
            <a href={item.href} class="menu-link display relative inline-block py-1 text-[clamp(30px,3vw,44px)]" aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
              <sup class="caps absolute top-1.5 -right-7 text-[10px]! tracking-normal! text-umber">{String(i + 1).padStart(2, '0')}</sup>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu-foot mt-10 space-y-5">
      <div>
        <p class="caps text-umber">Talk to us</p>
        <p class="mt-1 text-[15px]">
          <a href={`tel:${site.phones[0].tel}`} class="hover:text-cocoa">{site.phones[0].display}</a>
          <span aria-hidden="true"> · </span>
          <a href={`mailto:${site.email}`} class="hover:text-cocoa">{site.email}</a>
        </p>
      </div>
      <div>
        <p class="caps text-umber">Follow</p>
        <div class="mt-1 flex flex-wrap gap-x-6 gap-y-2">
          <a href={site.socials.facebook} class="caps text-ink hover:text-cocoa" rel="noopener" target="_blank">Facebook</a>
          <a href={site.socials.instagram} class="caps text-ink hover:text-cocoa" rel="noopener" target="_blank">Instagram</a>
          <a href={whatsappLink()} class="caps text-ink hover:text-cocoa" rel="noopener" target="_blank">WhatsApp</a>
        </div>
      </div>
    </div>
  </nav>
</div>

<style>
  .slab {
    position: absolute;
    inset-block: 0;
    right: 0;
    width: min(38vw, 500px);
    transform: translateX(104%);
    transition: transform 0.8s var(--ease-wipe);
    /* Close: the reverse order, faster */
    transition-delay: calc((2 - var(--k)) * 0.06s);
  }
  @media (max-width: 767px) {
    .slab {
      width: 100%;
    }
  }
  [data-open='true'] .slab {
    transform: none;
    /* Open: espresso → linen → paper, staggered */
    transition-delay: calc(var(--k) * 0.09s);
  }
  .menu-item {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.7s var(--ease-silk),
      transform 0.7s var(--ease-silk);
  }
  [data-open='true'] .menu-item {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.42s + var(--i) * 0.05s);
  }
  .menu-foot {
    opacity: 0;
    transition: opacity 0.7s;
  }
  [data-open='true'] .menu-foot {
    opacity: 1;
    transition-delay: 0.8s;
  }
  .menu-link {
    transition: opacity 0.3s;
  }
  .has-hot .menu-link:not(.is-hot) {
    opacity: 0.4;
  }
  .menu-link.is-hot {
    filter: url(#ripple);
  }
  .menu-link[aria-current='page']::before {
    content: '';
    position: absolute;
    left: -1.1rem;
    top: 50%;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--color-gold);
    transform: translateY(-60%) rotate(45deg);
  }
</style>
