---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Arrow from '../components/Arrow.astro';
import Eyebrow from '../components/Eyebrow.astro';
import FaqList from '../components/FaqList.astro';
import { site, addressLine, mapsLink, whatsappLink } from '../data/site';
import { faqsFor, faqSchema } from '../data/faq';

const crumbs = [{ name: 'Contact', href: '/contact/' }];
const faqs = faqsFor('contact');

const contactPage = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contact Buhle Country Estate',
  url: `${site.url}/contact/`,
  about: { '@id': `${site.url}/#venue` },
};
---

<Base
  title="Contact & Directions | Buhle Country Estate, Bishopstowe"
  description="Enquire about weddings, functions and conferences at Buhle Country Estate, Bishopstowe. Call 064 549 5380 or email events@buhleestate.co.za."
  crumbs={crumbs}
  schema={[contactPage, faqSchema(faqs)]}
>
  <PageHero
    slug="reception-tables-garden-view"
    imgClass="object-[50%_45%]"
    kicker="Contact & directions"
    lines={[{ t: 'Let’s get' }, { t: 'in touch.', i: true }]}
    intro="Tell us about your event, or ask for a viewing. Our events team replies within one working day."
    crumbs={crumbs}
  />

  <section id="enquire" data-tone="light" class="on-paper scroll-mt-10 bg-paper py-24 md:py-32">
    <div class="mx-auto grid max-w-[1500px] gap-16 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-7">
        <Eyebrow n="i.">Enquiry form</Eyebrow>
        <h2 class="display mt-6 mb-12 text-[clamp(40px,4.4vw,74px)] text-ink">
          <span class="block">Tell us about</span> <span class="it block text-cocoa">your event.</span>
        </h2>
        <EnquiryForm />
      </div>

      <aside class="md:col-span-5" aria-label="Contact details">
        <div class="sticky top-28 space-y-10 bg-cream p-8 md:p-10">
          <div>
            <p class="caps text-umber">Call</p>
            <ul class="mt-2 space-y-1">
              {site.phones.map((p) => <li><a href={`tel:${p.tel}`} class="inline-block py-1 font-display text-[28px] text-ink hover:text-cocoa">{p.display}</a></li>)}
            </ul>
          </div>
          <div>
            <p class="caps text-umber">Email</p>
            <a href={`mailto:${site.email}`} class="mt-2 inline-block py-1 font-display text-[26px] break-all text-ink hover:text-cocoa">{site.email}</a>
          </div>
          <div>
            <p class="caps text-umber">WhatsApp</p>
            <a href={whatsappLink()} class="btn btn-ink mt-3" rel="noopener" target="_blank">
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.3-.4.8-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.2-.2-.5-.3Z" /></svg>
              Message <em>us</em>
            </a>
          </div>
          <div>
            <p class="caps text-umber">Visit</p>
            <address class="mt-2 font-display text-[24px] leading-snug not-italic text-ink">{addressLine}</address>
            <p class="mt-2 text-[15px] text-ink/70">Viewings by appointment. About {site.minutesFromCity} minutes from the Pietermaritzburg CBD.</p>
            <a href={mapsLink} class="caps link-arrow mt-4 text-cocoa" rel="noopener" target="_blank">Open in Google Maps <Arrow /></a>
          </div>
          <div>
            <p class="caps text-umber">Follow</p>
            <div class="mt-2 flex gap-6">
              <a href={site.socials.facebook} class="caps py-2 text-ink hover:text-cocoa" rel="noopener" target="_blank">Facebook</a>
              <a href={site.socials.instagram} class="caps py-2 text-ink hover:text-cocoa" rel="noopener" target="_blank">Instagram</a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section data-tone="dark" class="bg-ink text-paper" aria-labelledby="map-title">
    <div class="grid md:grid-cols-12">
      <div class="px-5 py-20 md:col-span-4 md:px-14 md:py-28">
        <Eyebrow n="ii." class="text-gold-light">Directions</Eyebrow>
        <h2 id="map-title" class="display mt-6 text-[clamp(40px,4vw,66px)]">
          <span class="block">Finding</span> <span class="it block text-gold-light">the farm.</span>
        </h2>
        <p class="mt-6 text-paper/80">
          Buhle Country Estate is at Farm 10 of Kensington in Bishopstowe, just outside Pietermaritzburg. Search “Buhle Country Estate” in Google Maps or Waze, or
          use the button below for turn-by-turn directions.
        </p>
        <a href={mapsLink} class="btn btn-gold mt-8" rel="noopener" target="_blank">Get <em>directions</em></a>
      </div>
      <div class="min-h-[420px] md:col-span-8">
        <iframe
          title="Map showing Buhle Country Estate in Bishopstowe, Pietermaritzburg"
          src={`https://maps.google.com/maps?q=${encodeURIComponent(site.mapsQuery)}&z=12&output=embed`}
          class="h-full min-h-[420px] w-full border-0 grayscale-[35%] sepia-[15%]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <section data-tone="light" class="on-paper bg-paper py-24 md:py-32">
    <div class="mx-auto max-w-[1000px] px-5">
      <h2 class="display mb-8 text-[clamp(36px,3.6vw,56px)] text-ink">Before <span class="it text-cocoa">you visit</span></h2>
      <FaqList items={faqs} />
    </div>
  </section>
</Base>
