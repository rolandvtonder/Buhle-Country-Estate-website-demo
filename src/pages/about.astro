---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Eyebrow from '../components/Eyebrow.astro';
import EnquiryCTA from '../components/EnquiryCTA.astro';
import { site } from '../data/site';

const crumbs = [{ name: 'About', href: '/about/' }];

const about = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About Buhle Country Estate',
  url: `${site.url}/about/`,
  about: { '@id': `${site.url}/#venue` },
  mentions: [
    { '@type': 'Person', name: 'Nobuhle Mchunu', jobTitle: 'Founder', worksFor: { '@id': `${site.url}/#venue` } },
    { '@type': 'Organization', name: 'Jailbreak Caterers', foundingDate: '2005', founder: { '@type': 'Person', name: 'Nobuhle Mchunu' } },
  ],
};

const timeline = [
  ['Richmond, KZN', 'Nobuhle Mchunu grows up in Richmond, the youngest of five children.'],
  ['Studies', 'She studies accounting, then completes a diploma in food preparation at Capsicum.'],
  ['2005', 'She founds Jailbreak Caterers. Today the business employs more than 70 people.'],
  ['Bishopstowe', 'She buys a 16-hectare plot in the Bishopstowe countryside and builds a 210-seat venue.'],
  ['Today', 'With her daughter Nono, who studied media and marketing in Durban, she runs Buhle Country Estate as a family hospitality business.'],
];
---

<Base
  title="About Buhle Country Estate | Our Story, Bishopstowe KZN"
  description="Buhle Country Estate was built by caterer Nobuhle Mchunu on a 16-hectare farm in Bishopstowe, Pietermaritzburg. Meet the family behind the venue."
  crumbs={crumbs}
  schema={[about]}
>
  <PageHero
    slug="reception-hall-country-view"
    imgClass="object-[30%_35%]"
    kicker="Our story"
    lines={[{ t: 'A life' }, { t: 'well lived.', i: true }]}
    intro="Buhle means beauty in isiZulu. It is also at the heart of our founder’s name, Nobuhle, and you’ll see it in the view from the hall across the Bishopstowe hills."
    crumbs={crumbs}
  />

  <section data-tone="light" class="on-paper bg-paper py-28 md:py-36">
    <div class="mx-auto grid max-w-[1500px] gap-16 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-5">
        <div class="aspect-[4/5] overflow-hidden" data-reveal><Photo slug="buhle-estate-logo-mantel" sizes="(min-width: 768px) 40vw, 100vw" /></div>
      </div>
      <div class="md:col-span-7 md:pl-8">
        <Eyebrow n="i.">Where it began</Eyebrow>
        <h2 class="display mt-6 text-[clamp(40px,4.6vw,78px)] text-ink" data-reveal>
          <span class="block">From a catering</span> <span class="it block text-cocoa">kitchen to a</span> <span class="block">country estate.</span>
        </h2>
        <div class="prose-buhle mt-10 max-w-[60ch] text-ink/80" data-reveal style="--d:.1s">
          <p>
            Nobuhle Mchunu was born in Richmond, KwaZulu-Natal, the youngest of five. She studied accounting first, then followed her love of food to a
            diploma in food preparation at Capsicum. In 2005 she started <strong>Jailbreak Caterers</strong>, and grew it one event at a time into a
            business that now employs more than 70 people.
          </p>
          <p>
            Years of catering other people’s celebrations showed her what a venue needs to get right. So she bought a 16-hectare plot in Bishopstowe, just
            outside Pietermaritzburg, and built one: a 210-seat hall with glass doors onto the garden, a kitchen built for real service, and room on the
            lawn for ceremonies under the sky.
          </p>
          <p>
            Her daughter <strong>Nono</strong>, who studied media and marketing in Durban, joined to help shape the hospitality side of the business. Buhle
            Country Estate is still a family venture.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section data-tone="dark" class="bg-ink py-28 text-paper md:py-36">
    <div class="mx-auto max-w-[1500px] px-5 md:px-14">
      <Eyebrow n="ii." class="text-gold-light">The short version</Eyebrow>
      <ol class="mt-14 border-l border-gold/40">
        {
          timeline.map(([k, v], i) => (
            <li class="relative grid gap-3 py-8 pl-8 md:grid-cols-12 md:gap-10 md:pl-14" data-reveal style={`--d:${i * 0.06}s`}>
              <span class="absolute top-[2.6rem] -left-[5px] size-2.5 rotate-45 bg-gold" aria-hidden="true" />
              <h3 class="display text-[clamp(32px,3.4vw,54px)] text-gold-light md:col-span-4">{k}</h3>
              <p class="max-w-[56ch] text-[18px] text-paper/85 md:col-span-8 md:pt-2">{v}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section data-tone="light" class="on-paper bg-cream py-28 md:py-36">
    <div class="mx-auto max-w-[1500px] px-5 md:px-14">
      <Eyebrow n="iii.">The estate</Eyebrow>
      <h2 class="display mt-6 text-[clamp(40px,4.6vw,78px)] text-ink" data-reveal>
        <span class="block">Escape the hustle</span> <span class="it block text-cocoa">and bustle of the city.</span>
      </h2>
      <div class="mt-14 grid gap-10 md:grid-cols-3">
        {
          [
            { slug: 'reception-hall-garden-windows', t: 'The hall', d: 'Up to 210 guests, with glass stacking doors, picture windows, glossy tiles and recessed LED lighting.' },
            { slug: 'garden-ceremony-aisle', t: 'The gardens', d: 'Lawns for ceremonies, photographs and sundowners, with the farmland rolling away beyond.' },
            { slug: 'lounge-floral-ceiling', t: 'The details', d: 'Chandeliers, a stage, a glass main table and his and hers chairs, ready for whatever you plan.' },
          ].map((x, i) => (
            <article data-reveal style={`--d:${i * 0.1}s`}>
              <div class="aspect-[4/5] overflow-hidden"><Photo slug={x.slug} sizes="(min-width: 768px) 33vw, 100vw" /></div>
              <h3 class="display mt-6 text-[clamp(30px,2.6vw,42px)] text-ink">{x.t}</h3>
              <p class="mt-3 text-ink/75">{x.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section data-tone="light" class="on-paper bg-paper py-24">
    <div class="mx-auto flex max-w-[1100px] flex-col items-center gap-6 px-5 text-center">
      <p class="caps text-umber">Affiliation</p>
      <p class="font-display text-[clamp(26px,2.6vw,36px)] leading-snug text-ink" data-reveal>
        Buhle Estate is affiliated to <span class="italic text-cocoa">Mkhumbi Creative Solutions</span>, specialising in government catering, events and
        office meetings.
      </p>
    </div>
  </section>

  <EnquiryCTA />
</Base>
