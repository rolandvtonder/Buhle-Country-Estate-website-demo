---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import EnquiryCTA from '../components/EnquiryCTA.astro';
import { photos, type PhotoCat } from '../data/photos';
import { site } from '../data/site';

const crumbs = [{ name: 'Gallery', href: '/gallery/' }];

const order: PhotoCat[] = ['weddings', 'functions', 'venue', 'conferences', 'catering'];
const labels: Record<PhotoCat, string> = { weddings: 'Weddings', functions: 'Functions', venue: 'The venue', conferences: 'Conferences', catering: 'Catering' };

// Interleave categories so the "All" view reads as a mix, not in blocks.
const byCat = order.map((c) => Object.values(photos).filter((p) => p.cat === c));
const list = [];
for (let i = 0; byCat.some((b) => b[i]); i++) for (const b of byCat) if (b[i]) list.push(b[i]);

const items = await Promise.all(
  list.map(async (p) => {
    const full = await getImage({ src: p.src, format: 'webp', width: Math.min(1600, p.src.width) });
    return { ...p, full: full.src };
  }),
);

const gallerySchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageGallery',
  name: 'Buhle Country Estate gallery',
  url: `${site.url}/gallery/`,
  about: { '@id': `${site.url}/#venue` },
  numberOfItems: items.length,
};
---

<Base
  title="Gallery | Weddings & Events at Buhle Country Estate"
  description="Photos of weddings, birthdays, brunches, conferences and catering at Buhle Country Estate, a country events venue in Bishopstowe, Pietermaritzburg."
  crumbs={crumbs}
  schema={[gallerySchema]}
>
  <PageHero
    slug="white-wedding-reception-hall"
    imgClass="object-[50%_40%]"
    kicker="Gallery"
    lines={[{ t: 'Moments' }, { t: 'at Buhle.', i: true }]}
    intro="Real weddings, birthdays, brunches and conferences, styled by our couples, hosts and team. Choose a category, or open any photo to see it full size."
    crumbs={crumbs}
  />

  <section data-tone="light" class="on-paper bg-paper py-20 md:py-28">
    <div class="mx-auto max-w-[1600px] px-3 md:px-10">
      <div class="flex flex-wrap items-center justify-between gap-4 px-2">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Filter photos">
          <button type="button" data-filter="all" aria-pressed="true" class="caps min-h-11 border border-ink/25 px-5 py-2 transition-colors hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-paper">All</button>
          {
            order.map((c) => (
              <button type="button" data-filter={c} aria-pressed="false" class="caps min-h-11 border border-ink/25 px-5 py-2 transition-colors hover:border-ink aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-paper">
                {labels[c]}
              </button>
            ))
          }
        </div>
        <p data-gallery-count class="text-[14px] text-ink/60" aria-live="polite">Showing {items.length} photos</p>
      </div>

      <ul data-gallery class="mt-10 columns-2 gap-3 md:columns-3 xl:columns-4">
        {
          items.map((p) => (
            <li data-cat={p.cat} class="mb-3 break-inside-avoid">
              <button type="button" data-full={p.full} data-alt={p.alt} class="group block w-full overflow-hidden bg-linen" aria-label={`Open photo: ${p.alt}`}>
                <Photo slug={p.slug} sizes="(min-width: 1280px) 25vw, (min-width: 768px) 33vw, 50vw" widths={[400, 700, 1000]} imgClass="h-auto! transition-transform duration-[1200ms] ease-silk group-hover:scale-105" />
              </button>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <dialog id="lightbox" aria-label="Photo viewer" class="m-0 h-dvh max-h-none w-screen max-w-none bg-ink/95 p-0 text-paper backdrop:bg-ink/80">
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-end p-4">
        <button type="button" data-close class="caps flex min-h-12 items-center gap-3 bg-paper px-6 text-ink">Close <span aria-hidden="true" class="text-[18px] rotate-45 inline-block">+</span></button>
      </div>
      <div class="relative flex min-h-0 flex-1 items-center justify-center px-4 md:px-20">
        <img src="" alt="" class="max-h-full max-w-full object-contain" />
        <button type="button" data-prev class="absolute top-1/2 left-2 flex size-12 -translate-y-1/2 items-center justify-center bg-paper/15 hover:bg-paper/30 md:left-6" aria-label="Previous photo">
          <svg class="size-5 rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6" /></svg>
        </button>
        <button type="button" data-next class="absolute top-1/2 right-2 flex size-12 -translate-y-1/2 items-center justify-center bg-paper/15 hover:bg-paper/30 md:right-6" aria-label="Next photo">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 12h16M14 6l6 6-6 6" /></svg>
        </button>
      </div>
      <p data-caption class="px-5 py-5 text-center text-[15px] text-paper/80"></p>
    </div>
  </dialog>

  <EnquiryCTA slug="garden-ceremony-aisle" title={[{ t: 'Picture your' }, { t: 'day here.', i: true }]} />
</Base>
