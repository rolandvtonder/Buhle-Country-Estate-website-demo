---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import Eyebrow from '../components/Eyebrow.astro';
import FaqList from '../components/FaqList.astro';
import EnquiryCTA from '../components/EnquiryCTA.astro';
import { site, prices } from '../data/site';
import { faqsFor, faqSchema } from '../data/faq';

const crumbs = [{ name: 'Weddings', href: '/weddings/' }];
const faqs = faqsFor('weddings');

const included = [
  ['Exclusive use', 'No other functions on the estate on your day.'],
  ['Tables for 210', '10 to 12-seater tables, set to your guest count.'],
  ['White wooden stage', 'A raised stage for the bridal table, speeches or a band.'],
  ['Glass main table', 'With his and hers chairs for the two of you.'],
  ['Cake table', 'A dedicated, well-lit spot for the cake and the cutting.'],
  ['Gift station', 'A safe, tidy place for cards and gifts.'],
];

const styles = [
  {
    name: ['Simple', '& sweet'],
    text: 'A high tea with cakes, a garden ceremony and a chocolate bar. Relaxed, pretty, and easy on the budget.',
    slug: 'high-tea-station',
  },
  {
    name: ['Garden', 'lunch'],
    text: 'Lunch with champagne and canapés and a string quartet playing as guests arrive from the ceremony.',
    slug: 'garden-ceremony-draped-arch',
  },
  {
    name: ['Grand', 'evening'],
    text: 'A full band, a three-course meal, linen and crystal, with the hall lit for dancing late into the night.',
    slug: 'white-wedding-reception-hall',
  },
];

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Wedding venue hire',
  serviceType: 'Wedding venue',
  provider: { '@id': `${site.url}/#venue` },
  areaServed: 'Pietermaritzburg, KwaZulu-Natal',
  description: 'Country wedding venue for up to 210 guests with garden or indoor ceremony, in-house catering and an experienced event coordinator.',
  offers: {
    '@type': 'Offer',
    priceCurrency: 'ZAR',
    price: '150',
    priceSpecification: { '@type': 'UnitPriceSpecification', price: '150', priceCurrency: 'ZAR', unitText: 'per guest' },
    description: 'Venue hire from R150 per guest. Minimum R10 000 for fewer than 100 guests.',
  },
};
---

<Base
  title="Wedding Venue in Pietermaritzburg | Buhle Country Estate"
  description="Country wedding venue near Pietermaritzburg: garden or indoor ceremonies, receptions for up to 210 guests and in-house catering. Venue hire from R150 pp."
  crumbs={crumbs}
  schema={[service, faqSchema(faqs)]}
>
  <PageHero
    slug="garden-wedding-ceremony-gold-table"
    imgClass="object-[50%_60%]"
    kicker="Weddings in Pietermaritzburg"
    lines={[{ t: 'Our forever' }, { t: 'afters.', i: true }]}
    intro="Vows on the lawn under a wide KZN sky, then a reception for up to 210 guests in a hall full of light. One venue, one team, and no-one has to drive between the two."
    crumbs={crumbs}
  />

  <!-- Intro -->
  <section data-tone="light" class="on-paper bg-paper py-28 md:py-36">
    <div class="mx-auto grid max-w-[1500px] gap-16 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-6">
        <Eyebrow n="i.">A country wedding</Eyebrow>
        <h2 class="display mt-6 text-[clamp(40px,4.8vw,82px)] text-ink" data-reveal>
          <span class="block">Ceremony on the lawn.</span>
          <span class="it block text-cocoa">Dancing in the hall.</span>
        </h2>
      </div>
      <div class="space-y-5 text-ink/80 md:col-span-6 md:pt-16" data-reveal style="--d:.1s">
        <p>
          Buhle Country Estate is a private wedding venue on a {site.hectares}-hectare farm in Bishopstowe, {site.minutesFromCity} minutes from the
          Pietermaritzburg CBD. Couples marry outdoors under a draped arch on the lawn, or indoors in the hall, and move straight into the reception.
        </p>
        <p>
          The reception room opens onto the garden through glass stacking doors, with large picture windows, glossy tiles and recessed LED lighting. On a
          summer afternoon the doors fold back and the room spills onto the lawn. At night the chandeliers come on and it becomes a ballroom.
        </p>
        <p>
          Your day is run by our in-house event coordinator, who has twenty years of weddings behind her, and the food comes from our own kitchen. You deal
          with one team from the first viewing to the last dance.
        </p>
      </div>
    </div>
  </section>

  <!-- Ceremony options -->
  <section data-tone="dark" class="bg-ink text-paper">
    <div class="grid md:grid-cols-2">
      {
        [
          { slug: 'garden-ceremony-aisle', t: ['Garden', 'ceremony'], d: 'A white aisle runner across the lawn, a draped arch and your families seated in the sun. Photographs with trees and open sky behind you.' },
          { slug: 'indoor-ceremony-chairs', t: ['Indoor', 'ceremony'], d: 'Rain plan or first choice: rows of white chairs facing a dressed altar in the bright hall, with the reception set up next door.' },
        ].map((c, i) => (
          <article class="group relative aspect-[4/5] overflow-hidden md:aspect-auto md:h-[92svh]">
            <Photo slug={c.slug} sizes="(min-width: 768px) 50vw, 100vw" class="absolute inset-0" imgClass="transition-transform duration-[1600ms] ease-silk group-hover:scale-105" />
            <div class="absolute inset-0 bg-[linear-gradient(0deg,rgb(28_19_13/0.82),transparent_60%)]" />
            <div class="absolute inset-x-0 bottom-0 p-7 md:p-12">
              <p class="caps text-gold-light">Option 0{i + 1}</p>
              <h3 class="display mt-3 text-[clamp(40px,4.4vw,72px)]">
                <span class="block">{c.t[0]}</span>
                <span class="it block">{c.t[1]}</span>
              </h3>
              <p class="mt-4 max-w-[44ch] text-paper/85">{c.d}</p>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Venue hire includes + pricing -->
  <section data-tone="light" class="on-paper bg-cream py-28 md:py-36">
    <div class="mx-auto grid max-w-[1500px] gap-16 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-7">
        <Eyebrow n="ii.">Venue hire includes</Eyebrow>
        <h2 class="display mt-6 text-[clamp(40px,4.4vw,74px)] text-ink" data-reveal>
          <span class="block">The essentials,</span> <span class="it block text-cocoa">already taken care of.</span>
        </h2>
        <dl class="mt-12 grid gap-x-10 sm:grid-cols-2">
          {
            included.map(([k, v], i) => (
              <div class="border-t border-ink/15 py-6" data-reveal style={`--d:${(i % 2) * 0.08}s`}>
                <dt class="font-display text-[26px] leading-tight text-ink">{k}</dt>
                <dd class="mt-2 text-[16px] text-ink/75">{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <aside class="md:col-span-5" aria-labelledby="price-title">
        <div class="sticky top-28 bg-ink p-9 text-paper md:p-11" data-reveal>
          <p class="caps text-gold-light">Wedding pricing</p>
          <h2 id="price-title" class="display mt-4 text-[clamp(44px,4vw,64px)]">
            <span class="block text-[0.45em] tracking-[0.08em] text-paper/70">Venue hire from</span>
            <span class="block">{prices.weddingVenuePp}</span>
            <span class="it block text-[0.5em] text-gold-light">per guest</span>
          </h2>
          <ul class="mt-8 space-y-3 border-t border-paper/15 pt-6 text-[16px] text-paper/85">
            <li>Up to {site.capacity} guests</li>
            <li>Minimum venue hire of {prices.weddingMinimum} for fewer than 100 guests</li>
            <li>Catering menus from {prices.cateringPp} per guest</li>
            <li>Décor and coordinator quoted to your plans</li>
          </ul>
          <a href="/contact/#enquire" class="btn btn-gold mt-9 w-full justify-center">Request a <em>quote</em></a>
          <p class="mt-4 text-[13px] text-paper/60">Prices are a guide and are confirmed in your written quote.</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- Styles -->
  <section data-tone="light" class="on-paper bg-paper py-28 md:py-36">
    <div class="mx-auto max-w-[1500px] px-5 md:px-14">
      <Eyebrow n="iii.">Décor &amp; styling</Eyebrow>
      <div class="mt-6 flex flex-wrap items-end justify-between gap-8">
        <h2 class="display text-[clamp(40px,4.8vw,82px)] text-ink" data-reveal>
          <span class="block">Your style,</span> <span class="it block text-cocoa">your budget.</span>
        </h2>
        <p class="max-w-[46ch] text-ink/75" data-reveal>
          Décor is tailor-made to the two of you. Our coordinator can source and style everything, or work alongside your own décor team. Here are three
          ways couples have done it.
        </p>
      </div>
      <div class="mt-16 grid gap-10 md:grid-cols-3">
        {
          styles.map((s, i) => (
            <article data-reveal style={`--d:${i * 0.1}s`}>
              <div class="aspect-[4/5] overflow-hidden">
                <Photo slug={s.slug} sizes="(min-width: 768px) 33vw, 100vw" />
              </div>
              <h3 class="display mt-6 text-[clamp(32px,2.8vw,44px)] text-ink">
                {s.name[0]} <span class="it text-cocoa">{s.name[1]}</span>
              </h3>
              <p class="mt-3 text-ink/75">{s.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Coordinator + catering -->
  <section data-tone="dark" class="bg-ink py-28 text-paper md:py-36">
    <div class="mx-auto grid max-w-[1500px] items-center gap-16 px-5 md:grid-cols-2 md:px-14">
      <div class="grid grid-cols-2 gap-3">
        <div class="aspect-[3/4] overflow-hidden" data-reveal><Photo slug="bridal-table-chandelier" sizes="(min-width: 768px) 25vw, 50vw" /></div>
        <div class="mt-16 aspect-[3/4] overflow-hidden" data-reveal style="--d:.12s"><Photo slug="mint-wedding-cake" sizes="(min-width: 768px) 25vw, 50vw" /></div>
      </div>
      <div>
        <Eyebrow n="iv." class="text-gold-light">Your coordinator</Eyebrow>
        <h2 class="display mt-6 text-[clamp(40px,4.4vw,74px)]" data-reveal>
          <span class="block">Twenty years</span> <span class="it block text-gold-light">of wedding days.</span>
        </h2>
        <div class="mt-8 max-w-[52ch] space-y-5 text-paper/80" data-reveal style="--d:.1s">
          <p>
            Our in-house event coordinator has planned and run weddings for two decades. She’ll build your running order, brief your suppliers, keep the
            day on time and make sure you get to enjoy it. Her fee is quoted separately from venue hire and catering.
          </p>
          <p>
            Bringing your own photographer, DJ or décor team? Outside service providers are welcome, subject to the estate’s approval.
          </p>
        </div>
        <div class="mt-10 flex flex-wrap gap-3" data-reveal style="--d:.2s">
          <a href="/catering/" class="btn btn-gold">Wedding <em>menus</em></a>
          <a href="/tips-and-inspiration/wedding-planning-checklist/" class="btn btn-line text-paper">Planning checklist</a>
        </div>
      </div>
    </div>
  </section>

  <!-- How booking works -->
  <section data-tone="light" class="on-paper bg-cream py-28 md:py-36">
    <div class="mx-auto max-w-[1500px] px-5 md:px-14">
      <Eyebrow n="v.">How booking works</Eyebrow>
      <h2 class="display mt-6 text-[clamp(40px,4.4vw,74px)] text-ink" data-reveal>
        <span class="block">From first visit</span> <span class="it block text-cocoa">to first dance.</span>
      </h2>
      <ol class="mt-14 grid gap-px bg-ink/15 md:grid-cols-4">
        {
          [
            ['Enquire', 'Send us your date, guest count and the feel you’re after. We’ll confirm availability.'],
            ['View', 'Visit the estate, walk the garden and the hall, and meet your coordinator.'],
            ['Hold your date', 'We hold the date provisionally for 7 days. A booking fee secures it.'],
            ['Plan together', 'Menus, décor and running order, with payments spread out before the day.'],
          ].map(([t, d], i) => (
            <li class="bg-cream p-7 md:p-9" data-reveal style={`--d:${i * 0.08}s`}>
              <span class="font-display text-[54px] leading-none text-umber italic">0{i + 1}</span>
              <h3 class="display mt-5 text-[30px] text-ink">{t}</h3>
              <p class="mt-3 text-[16px] text-ink/75">{d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Gallery strip -->
  <section data-tone="dark" class="bg-ink py-3">
    <div class="grid grid-cols-2 gap-3 px-3 md:grid-cols-5">
      {
        ['wedding-monogram-backdrop-garden', 'sage-green-table-setting', 'wedding-stage-white-panels', 'table-number-white-roses', 'wedding-welcome-sign'].map((s, i) => (
          <div class:list={['aspect-[3/4] overflow-hidden', { 'max-md:hidden': i === 4 }]}>
            <Photo slug={s} sizes="(min-width: 768px) 20vw, 50vw" />
          </div>
        ))
      }
    </div>
    <div class="px-5 py-8 text-center">
      <a href="/gallery/" class="caps link-arrow text-gold-light">See more weddings in the gallery <Arrow /></a>
    </div>
  </section>

  <!-- FAQ -->
  <section data-tone="light" class="on-paper bg-paper py-28 md:py-36">
    <div class="mx-auto grid max-w-[1500px] gap-14 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-4">
        <Eyebrow n="vi.">Wedding questions</Eyebrow>
        <h2 class="display mt-6 text-[clamp(40px,4vw,66px)] text-ink" data-reveal>
          <span class="block">Good</span> <span class="it block text-cocoa">to know.</span>
        </h2>
      </div>
      <div class="md:col-span-8"><FaqList items={faqs} /></div>
    </div>
  </section>

  <EnquiryCTA slug="garden-ceremony-draped-arch" title={[{ t: 'Let’s talk about' }, { t: 'your day.', i: true }]} />
</Base>
