---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Photo from '../../components/Photo.astro';
import Arrow from '../../components/Arrow.astro';
import EnquiryCTA from '../../components/EnquiryCTA.astro';
import { articles } from '../../data/articles';
import { site } from '../../data/site';

const crumbs = [{ name: 'Tips & Inspiration', href: '/tips-and-inspiration/' }];
const [lead, ...rest] = articles;

const blog = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Buhle Country Estate: Tips & Inspiration',
  url: `${site.url}/tips-and-inspiration/`,
  publisher: { '@id': `${site.url}/#venue` },
  blogPost: articles.map((a) => ({ '@type': 'BlogPosting', headline: a.title, url: `${site.url}/tips-and-inspiration/${a.slug}/`, datePublished: a.published })),
};
---

<Base
  title="Wedding & Event Planning Tips | Buhle Country Estate"
  description="Wedding planning checklists, KZN summer wedding tips, a wedding colour guide and conference planning advice from the team at Buhle Country Estate."
  crumbs={crumbs}
  schema={[blog]}
>
  <PageHero
    slug="sage-green-centrepiece"
    imgClass="object-[50%_50%]"
    kicker="Tips & inspiration"
    lines={[{ t: 'Plan it' }, { t: 'beautifully.', i: true }]}
    intro="Practical advice from the people who host weddings, functions and conferences every week, plus colour and style ideas to get you started."
    crumbs={crumbs}
  />

  <section data-tone="light" class="on-paper bg-paper py-24 md:py-32">
    <div class="mx-auto max-w-[1500px] px-5 md:px-14">
      <article class="group grid items-center gap-10 md:grid-cols-12" data-reveal>
        <a href={`/tips-and-inspiration/${lead.slug}/`} class="block aspect-[4/3] overflow-hidden md:col-span-7" tabindex="-1" aria-hidden="true">
          <Photo slug={lead.hero} sizes="(min-width: 768px) 58vw, 100vw" imgClass="transition-transform duration-[1400ms] ease-silk group-hover:scale-105" />
        </a>
        <div class="md:col-span-5">
          <p class="caps text-umber">{lead.category} · {lead.readMins} min read</p>
          <h2 class="display mt-4 text-[clamp(38px,4vw,66px)] text-ink">
            <a href={`/tips-and-inspiration/${lead.slug}/`} class="hover:text-cocoa">{lead.lines.map((l) => <span class:list={['block', { it: l.i }]}>{l.t} </span>)}</a>
          </h2>
          <p class="mt-5 text-ink/75">{lead.excerpt}</p>
          <a href={`/tips-and-inspiration/${lead.slug}/`} class="caps link-arrow mt-7 text-cocoa">Read the guide <Arrow /></a>
        </div>
      </article>

      <div class="mt-24 grid gap-x-8 gap-y-16 md:grid-cols-3">
        {
          rest.map((a, i) => (
            <article class="group" data-reveal style={`--d:${i * 0.1}s`}>
              <a href={`/tips-and-inspiration/${a.slug}/`} class="block aspect-[4/5] overflow-hidden" tabindex="-1" aria-hidden="true">
                <Photo slug={a.hero} sizes="(min-width: 768px) 33vw, 100vw" imgClass="transition-transform duration-[1400ms] ease-silk group-hover:scale-105" />
              </a>
              <p class="caps mt-6 text-umber">{a.category} · {a.readMins} min read</p>
              <h2 class="display mt-3 text-[clamp(30px,2.6vw,42px)] text-ink">
                <a href={`/tips-and-inspiration/${a.slug}/`} class="hover:text-cocoa">{a.lines.map((l) => <span class:list={['block', { it: l.i }]}>{l.t} </span>)}</a>
              </h2>
              <p class="mt-3 text-ink/75">{a.excerpt}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <EnquiryCTA />
</Base>
