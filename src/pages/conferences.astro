---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Eyebrow from '../components/Eyebrow.astro';
import FaqList from '../components/FaqList.astro';
import EnquiryCTA from '../components/EnquiryCTA.astro';
import { site, prices } from '../data/site';
import { faqsFor, faqSchema } from '../data/faq';

const crumbs = [{ name: 'Conferences', href: '/conferences/' }];
const faqs = faqsFor('conferences');

const layouts = [
  { n: '15', name: 'Boardroom', d: 'One table, everyone face to face. Strategy sessions, board meetings, interviews.', shape: 'board' },
  { n: '50', name: 'U-shape', d: 'Open in the middle so the facilitator can move. Workshops and training.', shape: 'u' },
  { n: '100', name: 'Cinema', d: 'Rows facing the screen. Launches, briefings and annual meetings.', shape: 'cinema' },
];

const packages = [
  { name: 'Breakfast', time: '08:00 – 12:00', price: `From ${prices.breakfastConference}`, items: ['Coffee & tea on arrival', 'Morning tea & eats', 'Lunch', 'Venue & standard equipment'] },
  { name: 'Half day', time: '08:00 – 14:00', price: `From ${prices.halfDayConference}`, items: ['Coffee & tea on arrival', 'Morning tea & eats', 'Lunch', 'Venue & standard equipment'] },
  { name: 'Full day', time: 'Full working day', price: 'On request', items: ['Coffee & tea on arrival', 'Morning tea & eats', 'Lunch', 'Afternoon tea', 'Venue & standard equipment'] },
];

const service = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Conference venue hire',
  serviceType: 'Conference venue',
  provider: { '@id': `${site.url}/#venue` },
  areaServed: 'Pietermaritzburg, KwaZulu-Natal',
  description: 'Conference and training venue for 15 to 100 delegates, with catering packages and standard conference equipment.',
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Conference packages',
    itemListElement: [
      { '@type': 'Offer', name: 'Breakfast conference package (08:00–12:00)', price: '190', priceCurrency: 'ZAR' },
      { '@type': 'Offer', name: 'Half day conference package (08:00–14:00)', price: '275', priceCurrency: 'ZAR' },
      { '@type': 'Offer', name: 'Full day conference package' },
    ],
  },
};
---

<Base
  title="Conference Venue in Pietermaritzburg | Buhle Country Estate"
  description="Affordable conference and training venue outside Pietermaritzburg for 15 to 100 delegates. Day packages from R190 per delegate, catering included."
  crumbs={crumbs}
  schema={[service, faqSchema(faqs)]}
>
  <PageHero
    slug="conference-cinema-style"
    imgClass="object-[50%_45%]"
    kicker="Conferences & corporate functions"
    lines={[{ t: 'Think clearer,' }, { t: 'out of town.', i: true }]}
    intro="Fifteen minutes from the Pietermaritzburg CBD and a world away from the office. Conference packages for 15 to 100 delegates, with catering from our own kitchen."
    crumbs={crumbs}
  />

  <section data-tone="light" class="on-paper bg-paper py-28 md:py-36">
    <div class="mx-auto grid max-w-[1500px] gap-16 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-6">
        <Eyebrow n="i.">Corporate &amp; private</Eyebrow>
        <h2 class="display mt-6 text-[clamp(40px,4.8vw,82px)] text-ink" data-reveal>
          <span class="block">One of KZN’s</span> <span class="it block text-cocoa">most economical</span> <span class="block">conference venues.</span>
        </h2>
      </div>
      <div class="space-y-5 text-ink/80 md:col-span-6 md:pt-16" data-reveal style="--d:.1s">
        <p>
          Buhle Country Estate hosts small training sessions and large annual conferences, product launches, company training, team-building days and
          year-end functions. You get a quiet country setting with green views, and it’s still close enough to Pietermaritzburg for a same-day return.
        </p>
        <p>
          An on-site conference coordinator sets the room the way you need it and keeps the tea and lunch breaks on time, and our in-house kitchen does the
          catering. Every package includes venue hire and standard equipment: flip charts, pens and pads, jugs of water and mints.
        </p>
      </div>
    </div>
  </section>

  <!-- Layouts -->
  <section data-tone="dark" class="bg-ink py-28 text-paper md:py-36">
    <div class="mx-auto max-w-[1500px] px-5 md:px-14">
      <Eyebrow n="ii." class="text-gold-light">Room layouts</Eyebrow>
      <h2 class="display mt-6 text-[clamp(40px,4.4vw,74px)]" data-reveal>
        <span class="block">Set for</span> <span class="it block text-gold-light">the way you work.</span>
      </h2>
      <div class="mt-16 grid gap-px bg-paper/15 md:grid-cols-3">
        {
          layouts.map((l, i) => (
            <article class="bg-ink p-8 md:p-10" data-reveal style={`--d:${i * 0.1}s`}>
              <svg viewBox="0 0 120 80" class="h-24 w-auto text-gold" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                {l.shape === 'board' && (
                  <>
                    <rect x="30" y="28" width="60" height="24" rx="2" />
                    {[38, 52, 66, 80].map((x) => <circle cx={x} cy="20" r="3.5" />)}
                    {[38, 52, 66, 80].map((x) => <circle cx={x} cy="60" r="3.5" />)}
                    <circle cx="22" cy="40" r="3.5" />
                    <circle cx="98" cy="40" r="3.5" />
                  </>
                )}
                {l.shape === 'u' && (
                  <>
                    <path d="M25 15v50h70V15" />
                    <path d="M33 15v42h54V15" />
                    {[22, 34, 46].map((y) => <circle cx="17" cy={y} r="3" />)}
                    {[22, 34, 46].map((y) => <circle cx="103" cy={y} r="3" />)}
                    {[40, 52, 64, 76].map((x) => <circle cx={x} cy="73" r="3" />)}
                    <rect x="50" y="4" width="20" height="4" fill="currentColor" />
                  </>
                )}
                {l.shape === 'cinema' && (
                  <>
                    <rect x="30" y="4" width="60" height="4" fill="currentColor" />
                    {[24, 38, 52, 66].map((y) => [24, 36, 48, 60, 72, 84, 96].map((x) => <circle cx={x} cy={y} r="3" />))}
                  </>
                )}
              </svg>
              <p class="mt-8 font-display text-[clamp(64px,6vw,96px)] leading-none text-paper tabular-nums">{l.n}</p>
              <h3 class="caps mt-2 text-gold-light">Delegates · {l.name}</h3>
              <p class="mt-4 text-paper/75">{l.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Packages -->
  <section data-tone="light" class="on-paper bg-cream py-28 md:py-36">
    <div class="mx-auto max-w-[1500px] px-5 md:px-14">
      <Eyebrow n="iii.">Day packages</Eyebrow>
      <div class="mt-6 flex flex-wrap items-end justify-between gap-8">
        <h2 class="display text-[clamp(40px,4.4vw,74px)] text-ink" data-reveal>
          <span class="block">Priced</span> <span class="it block text-cocoa">per delegate.</span>
        </h2>
        <p class="max-w-[44ch] text-ink/75" data-reveal>All packages include the venue, flip charts, pens and pads, jugs of water and mints. Dietary requirements can be catered for with notice.</p>
      </div>
      <div class="mt-14 grid gap-5 md:grid-cols-3">
        {
          packages.map((p, i) => (
            <article class:list={['flex flex-col p-8 md:p-10', i === 1 ? 'bg-ink text-paper' : 'bg-paper text-ink']} data-reveal style={`--d:${i * 0.1}s`}>
              <p class:list={['caps', i === 1 ? 'text-gold-light' : 'text-umber']}>{p.time}</p>
              <h3 class="display mt-4 text-[clamp(40px,3.6vw,58px)]">{p.name}</h3>
              <p class="mt-2 font-display text-[28px] italic">
                {p.price}
                {p.price.startsWith('From') && <span class="text-[17px] not-italic opacity-70"> per delegate</span>}
              </p>
              <ul class:list={['mt-8 flex-1 space-y-3 border-t pt-6 text-[16px]', i === 1 ? 'border-paper/20' : 'border-ink/15']}>
                {p.items.map((it) => (
                  <li class="flex gap-3">
                    <span class="mt-2.5 size-1.5 shrink-0 rotate-45 bg-gold" aria-hidden="true" />
                    {it}
                  </li>
                ))}
              </ul>
              <a href="/contact/#enquire" class:list={['btn mt-9 justify-center', i === 1 ? 'btn-gold' : 'btn-ink']}>
                Book <em>{p.name.toLowerCase()}</em>
              </a>
            </article>
          ))
        }
      </div>

      <div class="mt-16 grid gap-10 md:grid-cols-2">
        <div data-reveal>
          <h3 class="display text-[34px] text-ink">Optional <span class="it text-cocoa">extras</span></h3>
          <ul class="mt-5 divide-y divide-ink/15 border-y border-ink/15 text-[16px]">
            {['Data projector', 'P.A. system', 'Bottled water', 'Extra pens & pads', 'Jugs of fruit juice'].map((x) => <li class="py-3">{x}</li>)}
          </ul>
          <p class="mt-4 text-[14px] text-ink/60">Extras are priced in your quote.</p>
        </div>
        <div data-reveal style="--d:.1s">
          <h3 class="display text-[34px] text-ink">Ideal <span class="it text-cocoa">for</span></h3>
          <ul class="mt-5 divide-y divide-ink/15 border-y border-ink/15 text-[16px]">
            {['Company training & workshops', 'Annual general meetings', 'Product launches', 'Team-building days', 'Year-end & private functions'].map((x) => <li class="py-3">{x}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section data-tone="dark" class="bg-ink py-3">
    <div class="grid grid-cols-2 gap-3 px-3 md:grid-cols-4">
      {['conference-seating-rows', 'conference-coffee-station', 'conference-podium-screen', 'breakfast-croissants'].map((s) => (
        <div class="aspect-[3/4] overflow-hidden"><Photo slug={s} sizes="(min-width: 768px) 25vw, 50vw" /></div>
      ))}
    </div>
  </section>

  <section data-tone="light" class="on-paper bg-paper py-28 md:py-36">
    <div class="mx-auto grid max-w-[1500px] gap-14 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-4">
        <Eyebrow n="iv.">Conference questions</Eyebrow>
        <h2 class="display mt-6 text-[clamp(40px,4vw,66px)] text-ink" data-reveal>
          <span class="block">Before</span> <span class="it block text-cocoa">you book.</span>
        </h2>
        <a href="/tips-and-inspiration/how-to-plan-a-conference/" class="caps link-arrow mt-8 text-cocoa">Conference planning guide</a>
      </div>
      <div class="md:col-span-8"><FaqList items={faqs} /></div>
    </div>
  </section>

  <EnquiryCTA
    slug="conference-seating-rows"
    title={[{ t: 'Book your next' }, { t: 'conference with us.', i: true }]}
    text="Tell us your date, delegate numbers and the package you need. We’ll confirm availability and send a quote. You’ll be back again!"
  />
</Base>
