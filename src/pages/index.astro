---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Arrow from '../components/Arrow.astro';
import Eyebrow from '../components/Eyebrow.astro';
import FaqList from '../components/FaqList.astro';
import EnquiryCTA from '../components/EnquiryCTA.astro';
import { site, prices, addressLine, mapsLink } from '../data/site';
import { faqsFor, faqSchema } from '../data/faq';

const heroSlides = ['garden-wedding-ceremony-gold-table', 'reception-hall-country-view', 'white-wedding-reception-hall', 'garden-ceremony-draped-arch'];
const heroPos: Record<string, string> = {
  'garden-wedding-ceremony-gold-table': 'object-[50%_60%]',
  'reception-hall-country-view': 'object-[30%_35%]',
  'white-wedding-reception-hall': 'object-[50%_40%]',
  'garden-ceremony-draped-arch': 'object-[50%_55%]',
};

const panels = [
  {
    href: '/weddings/',
    slug: 'bridal-table-chandelier',
    name: ['Weddings', 'Forever afters'],
    cta: 'Explore weddings',
    specs: [['Guests', 'Up to 210'], ['Venue hire', `From ${prices.weddingVenuePp} pp`]],
  },
  {
    href: '/conferences/',
    slug: 'conference-cinema-style',
    name: ['Conferences', '& Training'],
    cta: 'Explore conferences',
    specs: [['Delegates', 'Up to 100'], ['Packages', `From ${prices.breakfastConference} pp`]],
  },
  {
    href: '/private-functions/',
    slug: 'pink-birthday-backdrop',
    name: ['Private', 'Functions'],
    cta: 'Explore functions',
    specs: [['Birthdays', 'Showers & brunches'], ['Year-ends', 'Family gatherings']],
  },
];

const included = ['Exclusive use of the venue', '10 to 12-seater tables', 'White wooden stage', 'Glass main table', 'His & hers chairs', 'Cake table & gift station'];

const homeFaqs = faqsFor('home');
---

<Base
  title="Buhle Country Estate | Wedding & Conference Venue, Pietermaritzburg"
  description="Private country wedding, function and conference venue in Bishopstowe, 15 minutes from Pietermaritzburg. Up to 210 guests, with in-house catering."
  schema={[faqSchema(homeFaqs)]}
>
  <!-- HERO: slow photo crossfade under a condensed headline. Scrolling on
       blurs, dims and shrinks it back as the page transition. -->
  <section data-hero data-tone="dark" class="relative h-svh min-h-[620px] overflow-hidden bg-ink text-paper">
    <div data-hero-stage class="absolute inset-0 origin-center will-change-transform">
      <div data-slides class="absolute inset-0">
        {
          heroSlides.map((s, i) => (
            <div class:list={['hero-slide absolute inset-0 overflow-hidden', { 'is-active': i === 0 }]}>
              <Photo slug={s} sizes="100vw" eager={i === 0} alt={i === 0 ? undefined : ''} imgClass={heroPos[s]} />
            </div>
          ))
        }
      </div>
      <div class="absolute inset-0 bg-[linear-gradient(90deg,rgb(28_19_13/0.62),rgb(28_19_13/0.15)_60%,transparent)]"></div>
      <div class="absolute inset-x-0 bottom-0 h-2/5 bg-[linear-gradient(0deg,rgb(28_19_13/0.6),transparent)]"></div>

      <div class="absolute inset-0 mx-auto max-w-[1680px] px-5 pt-[clamp(110px,15vh,150px)] md:px-14">
        <p class="caps mb-6 text-gold-light">Wedding &amp; conference venue · Pietermaritzburg</p>
        <h1 class="display text-[clamp(52px,7.8vw,140px)] drop-shadow-[0_4px_30px_rgb(0_0_0/0.35)]">
          <span class="block pl-[1.4em]">Celebrate in the</span>
          <span class="it block">Countryside.</span>
          <span class="block">Gather at</span>
          <span class="it block">Buhle.</span>
        </h1>
        <p class="mt-10 max-w-[40ch] text-[17px] text-paper/90 md:ml-[clamp(0px,19vw,330px)]">
          A private wedding, function and conference venue on a {site.hectares}-hectare farm in Bishopstowe, {site.minutesFromCity} minutes from
          Pietermaritzburg. Up to {site.capacity} guests, with garden views and in-house catering.
        </p>
      </div>
    </div>
  </section>

  <!-- THE VENUE: three tall panels slide in from the right one after another -->
  <section id="venue" data-panels data-tone="dark" class="relative bg-ink" aria-labelledby="venue-title">
    <h2 id="venue-title" class="sr-only">What we host</h2>
    <div class="grid h-svh min-h-[640px] grid-cols-3 gap-[3px] overflow-hidden max-md:h-auto max-md:grid-cols-1">
      {
        panels.map((p, i) => (
          <a href={p.href} class="panel group relative block overflow-hidden bg-espresso max-md:h-[78svh]" style={`--i:${i}`}>
            <Photo slug={p.slug} alt="" sizes="(min-width: 768px) 34vw, 100vw" class="absolute inset-0" imgClass="transition-transform duration-[1600ms] ease-silk group-hover:scale-105" />
            <div class="absolute inset-0 bg-[linear-gradient(180deg,rgb(28_19_13/0.7),transparent_45%,rgb(28_19_13/0.55))]" />
            <div class="relative flex h-full flex-col justify-between p-7 pt-24 text-paper md:p-9 md:pt-28">
              <div>
                <p class="caps text-gold-light">0{i + 1}</p>
                <h3 class="display mt-3 text-[clamp(40px,3.8vw,66px)]">
                  <span class="block">{p.name[0]}</span>
                  <span class="it block">{p.name[1]}</span>
                </h3>
                <dl class="specs mt-7 space-y-3">
                  {p.specs.map(([k, v]) => (
                    <div>
                      <dt class="caps text-paper/70">{k}</dt>
                      <dd class="font-display text-[22px]">{v}</dd>
                    </div>
                  ))}
                </dl>
              </div>
              <span class="caps link-arrow self-start text-paper">
                {p.cta} <Arrow />
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <!-- STORY + numbers -->
  <section data-tone="light" class="on-paper bg-paper py-28 md:py-40">
    <div class="mx-auto grid max-w-[1500px] gap-16 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-7">
        <Eyebrow n="i.">Escape the city</Eyebrow>
        <h2 class="display mt-6 text-[clamp(42px,5.4vw,92px)] text-ink" data-reveal>
          <span class="block">A farm in the hills,</span>
          <span class="it block text-cocoa">built for the</span>
          <span class="block">big days.</span>
        </h2>
        <div class="mt-10 max-w-[58ch] space-y-5 text-ink/80" data-reveal style="--d:.1s">
          <p>
            Buhle Country Estate sits on {site.hectares} hectares of farmland in Bishopstowe, far enough from the city to feel like an escape and only
            {site.minutesFromCity} minutes from the Pietermaritzburg CBD. The reception hall has glass stacking doors onto the garden, large picture windows,
            glossy tiles and soft LED lighting, so it’s bright by day and warm by night.
          </p>
          <p>
            The estate was built by Nobuhle Mchunu, who trained in food preparation and started Jailbreak Caterers in 2005. Our kitchen and event team come from that
            background, which is why the food and the timing of your day get as much care as the décor.
          </p>
        </div>
        <a href="/about/" class="caps link-arrow mt-10 text-cocoa" data-reveal style="--d:.2s">Our story <Arrow /></a>
      </div>
      <div class="relative md:col-span-5">
        <div class="aspect-[4/5] overflow-hidden" data-reveal>
          <Photo slug="reception-hall-country-view" sizes="(min-width: 768px) 40vw, 100vw" imgClass="object-[30%_40%]" />
        </div>
        <div class="absolute -bottom-10 -left-6 hidden aspect-square w-[46%] overflow-hidden border-[10px] border-paper md:block" data-reveal style="--d:.2s">
          <Photo slug="protea-centrepiece" sizes="20vw" />
        </div>
      </div>
    </div>

    <dl class="mx-auto mt-28 grid max-w-[1500px] grid-cols-2 gap-y-12 px-5 md:mt-36 md:grid-cols-4 md:px-14">
      {
        [
          [String(site.capacity), 'Guests in the hall'],
          [String(site.hectares), 'Hectares of farmland'],
          [String(site.minutesFromCity), 'Minutes from PMB CBD'],
          ['20', 'Years’ coordinating experience'],
        ].map(([n, l], i) => (
          <div class="flex flex-col-reverse justify-end border-l border-ink/15 pl-5" data-reveal style={`--d:${i * 0.08}s`}>
            <dt class="caps mt-3 text-umber">{l}</dt>
            <dd class="font-display text-[clamp(56px,6vw,96px)] leading-none text-cocoa tabular-nums">{n}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- INCLUDED -->
  <section data-tone="light" class="on-paper bg-cream py-28 md:py-36">
    <div class="mx-auto grid max-w-[1500px] items-center gap-14 px-5 md:grid-cols-2 md:px-14">
      <div class="grid grid-cols-2 gap-3">
        <div class="aspect-[3/4] overflow-hidden" data-reveal><Photo slug="garden-ceremony-draped-arch" sizes="(min-width: 768px) 25vw, 50vw" /></div>
        <div class="mt-16 aspect-[3/4] overflow-hidden" data-reveal style="--d:.12s"><Photo slug="monogram-wedding-cake" sizes="(min-width: 768px) 25vw, 50vw" /></div>
      </div>
      <div>
        <Eyebrow n="ii.">Venue hire includes</Eyebrow>
        <h2 class="display mt-6 text-[clamp(40px,4.6vw,78px)] text-ink" data-reveal>
          <span class="block">Everything you need,</span>
          <span class="it block text-cocoa">already in place.</span>
        </h2>
        <ul class="mt-10 grid gap-x-8 sm:grid-cols-2">
          {
            included.map((item, i) => (
              <li class="flex items-baseline gap-4 border-b border-ink/15 py-4" data-reveal style={`--d:${i * 0.05}s`}>
                <span class="font-display text-[15px] text-umber italic">{String(i + 1).padStart(2, '0')}</span>
                <span class="text-[17px]">{item}</span>
              </li>
            ))
          }
        </ul>
        <p class="mt-8 text-ink/75" data-reveal>
          Venue hire from <strong class="text-ink">{prices.weddingVenuePp} per guest</strong>. Add our in-house catering, an experienced event coordinator and
          décor tailored to your style and budget.
        </p>
        <div class="mt-9 flex flex-wrap gap-3" data-reveal>
          <a href="/weddings/" class="btn btn-ink">Wedding <em>details</em></a>
          <a href="/contact/#enquire" class="btn btn-line text-ink">Request a quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CATERING -->
  <section data-tone="dark" class="relative overflow-hidden bg-ink py-28 text-paper md:py-40">
    <div class="mx-auto grid max-w-[1500px] gap-14 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-5 md:pt-10">
        <Eyebrow n="iii." class="text-gold-light">In-house catering</Eyebrow>
        <h2 class="display mt-6 text-[clamp(42px,5vw,86px)]" data-reveal>
          <span class="block">Food is where</span>
          <span class="it block text-gold-light">we began.</span>
        </h2>
        <p class="mt-8 max-w-[46ch] text-paper/80" data-reveal style="--d:.1s">
          Rosemary and garlic leg of lamb, butter chicken, cinnamon-roasted butternut, individual lemon cheesecakes. Plated or buffet, cooked on site by the
          team behind Jailbreak Caterers. Menus from <strong class="text-paper">{prices.cateringPp} per guest</strong>, including crockery, glassware and waiting
          staff.
        </p>
        <a href="/catering/" class="btn btn-gold mt-10" data-reveal style="--d:.2s">See the <em>menus</em></a>
      </div>
      <div class="grid grid-cols-6 gap-3 md:col-span-7">
        <div class="col-span-4 aspect-[4/5] overflow-hidden" data-reveal><Photo slug="high-tea-station" sizes="(min-width: 768px) 38vw, 66vw" /></div>
        <div class="col-span-2 flex flex-col gap-3">
          <div class="aspect-square overflow-hidden" data-reveal style="--d:.1s"><Photo slug="cheesecake-dessert" sizes="(min-width: 768px) 19vw, 33vw" /></div>
          <div class="aspect-square overflow-hidden" data-reveal style="--d:.18s"><Photo slug="sparkling-welcome-drinks" sizes="(min-width: 768px) 19vw, 33vw" /></div>
          <div class="aspect-square overflow-hidden" data-reveal style="--d:.26s"><Photo slug="tropical-fruit-platter" sizes="(min-width: 768px) 19vw, 33vw" /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- GALLERY TEASER -->
  <section data-tone="light" class="on-paper bg-paper py-28 md:py-36">
    <div class="mx-auto max-w-[1500px] px-5 md:px-14">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <Eyebrow n="iv.">Recent celebrations</Eyebrow>
          <h2 class="display mt-6 text-[clamp(42px,5vw,86px)] text-ink" data-reveal>
            <span class="block">Every event,</span>
            <span class="it block text-cocoa">its own story.</span>
          </h2>
        </div>
        <a href="/gallery/" class="caps link-arrow text-cocoa">View the gallery <Arrow /></a>
      </div>
      <div class="mt-14 grid grid-cols-2 gap-3 md:grid-cols-4">
        {
          ['white-wedding-reception-hall', 'womens-day-brunch', 'mint-wedding-cake', 'conference-seating-rows', 'garden-ceremony-aisle', 'tall-white-floral-centrepieces', 'baby-shower-balloon-arch', 'table-number-white-roses'].map((s, i) => (
            <a href="/gallery/" class:list={['group block overflow-hidden', i % 3 === 0 ? 'aspect-[3/4]' : 'aspect-square']} data-reveal style={`--d:${(i % 4) * 0.06}s`} tabindex="-1" aria-hidden="true">
              <Photo slug={s} sizes="(min-width: 768px) 25vw, 50vw" imgClass="transition-transform duration-[1400ms] ease-silk group-hover:scale-105" />
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ + LOCATION -->
  <section data-tone="light" class="on-paper bg-cream py-28 md:py-36">
    <div class="mx-auto grid max-w-[1500px] gap-16 px-5 md:grid-cols-12 md:px-14">
      <div class="md:col-span-7">
        <Eyebrow n="v.">Good to know</Eyebrow>
        <h2 class="display mt-6 mb-10 text-[clamp(40px,4.4vw,74px)] text-ink" data-reveal>
          <span class="block">Questions,</span> <span class="it block text-cocoa">answered.</span>
        </h2>
        <FaqList items={homeFaqs} />
        <a href="/faq/" class="caps link-arrow mt-8 text-cocoa">All questions <Arrow /></a>
      </div>
      <div class="md:col-span-5">
        <div class="sticky top-28">
          <p class="caps text-umber">Find us</p>
          <address class="mt-3 font-display text-[30px] leading-tight not-italic text-ink">{addressLine}</address>
          <p class="mt-4 text-ink/75">About a {site.minutesFromCity}-minute drive from the Pietermaritzburg CBD, out past the city into the Bishopstowe farmlands.</p>
          <a href={mapsLink} class="btn btn-ink mt-7" rel="noopener" target="_blank">Get <em>directions</em> <Arrow /></a>
          <div class="mt-8 aspect-[4/3] overflow-hidden bg-linen">
            <iframe
              title="Map showing Buhle Country Estate in Bishopstowe, Pietermaritzburg"
              src={`https://maps.google.com/maps?q=${encodeURIComponent(site.mapsQuery)}&z=13&output=embed`}
              class="h-full w-full border-0 grayscale-[35%] sepia-[15%]"
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"></iframe>
          </div>
        </div>
      </div>
    </div>
  </section>

  <EnquiryCTA />
</Base>

<style>
  /* Panels wait off to the right until the section is in view. */
  :global(.js) [data-panels] .panel {
    transform: translateX(calc(100% + 100vw));
    transition: transform 1.1s var(--ease-wipe);
    transition-delay: calc(0.12s + var(--i) * 0.16s);
  }
  :global(.js) [data-panels].is-shown .panel {
    transform: none;
  }
  :global(.js) [data-panels] .specs {
    opacity: 0;
    transition: opacity 0.7s 1.4s;
  }
  :global(.js) [data-panels].is-shown .specs {
    opacity: 1;
  }
  @media (max-width: 767px) {
    :global(.js) [data-panels] .panel {
      transition-delay: 0.1s;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) [data-panels] .panel,
    :global(.js) [data-panels] .specs {
      transform: none;
      opacity: 1;
    }
  }
</style>
